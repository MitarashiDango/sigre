    {
      "id": "mastodon-cavage-post-rsa-sha256",
      "target": "Mastodon Cavage POST compatibility form",
      "description": "Locally constructed POST vector following the fixed Mastodon request signing code, including its header insertion order and query-preserving request-target rule.",
      "construction": "locally constructed from fixed source behavior; not captured from a running Mastodon server",
      "sources": [
        {
          "url": "https://github.com/mastodon/mastodon/blob/f80b1ba92e63c3da771b405b9100f5c9abda909f/app/lib/http_signature_draft.rb#L14-L28",
          "revision": "f80b1ba92e63c3da771b405b9100f5c9abda909f",
          "assertion": "The request-target retains the query, is appended after the ordinary signed headers, and the wire algorithm is rsa-sha256."
        },
        {
          "url": "https://github.com/mastodon/mastodon/blob/f80b1ba92e63c3da771b405b9100f5c9abda909f/app/lib/request.rb#L151-L164",
          "revision": "f80b1ba92e63c3da771b405b9100f5c9abda909f",
          "assertion": "A request with a body inserts Host, Date, and Digest in that order before signing."
        }
      ],
      "generation": "README.md, Fixed signature generation",
      "independent_validation": "README.md, Independent signature verification",
      "message": {
        "method": "POST",
        "url": "https://mastodon.example/inbox?shared=1&next=%2Fitems",
        "request_target": "/inbox?shared=1&next=%2Fitems",
        "headers": [
          {"name": "Host", "values": ["mastodon.example"]},
          {"name": "Date", "values": ["Wed, 05 Aug 2026 03:00:00 GMT"]},
          {"name": "Digest", "values": ["SHA-256=wUcY70G61UmGiv1h5BcDptK4F4dQwSC8GYamueGOwQI="]},
          {"name": "Content-Type", "values": ["application/activity+json"]}
        ],
        "body": "{\"@context\":\"https://www.w3.org/ns/activitystreams\",\"id\":\"https://sender.example/activities/mastodon-fixture\",\"type\":\"Create\"}"
      },
      "signed_headers": ["host", "date", "digest", "(request-target)"],
      "expected_signing_string": "host: mastodon.example\ndate: Wed, 05 Aug 2026 03:00:00 GMT\ndigest: SHA-256=wUcY70G61UmGiv1h5BcDptK4F4dQwSC8GYamueGOwQI=\n(request-target): post /inbox?shared=1&next=%2Fitems",
      "key_id": "https://sender.example/users/mastodon#main-key",
      "wire_algorithm": "rsa-sha256",
      "trusted_algorithm": "AlgorithmRSAPKCS1v15SHA256",
      "signature_placement": "Signature",
      "signature_header_value": "keyId=\"https://sender.example/users/mastodon#main-key\",algorithm=\"rsa-sha256\",headers=\"host date digest (request-target)\",signature=\"\"",
      "signature_base64": "",
      "verification_key_file": "../cavage-draft-12/keys/rsa-public.pem",
      "signing_key_file": "../cavage-draft-12/keys/rsa-private.pem",
      "verification_time": "2026-08-05T03:00:00Z",
      "strict_rejection": "ErrInvalidSignatureAlgorithm",
      "verification_compatibility": {
        "allowed_legacy_algorithms": ["AlgorithmRSAPKCS1v15SHA256"]
      },
      "signing_compatibility": {
        "algorithm_field": "AlgorithmFieldLegacy",
        "exact_headers": ["host", "date", "digest", "(request-target)"]
      }
    },
